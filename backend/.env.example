# development | test | production  (/testData routes only exist in development and test)
ENV=development
PORT=3001
# Database name goes in the path. In ENV=test, "-test" is appended to it.
MONGO_URI=mongodb://localhost:27017/twitter-clone-db
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in seconds
JWT_EXPIRES=3600
# Comma separated, e.g. http://localhost:3000,https://myapp.com  (or * for any)
CORS_ORIGINS=*
# Used in password-reset links
FRONTEND_URL=http://localhost:3000
