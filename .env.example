# Settings for `docker compose` (copy this file to .env and fill it in; .env is never committed).

# --- Database (the "mongo" container) ---
MONGO_USER=admin
# Letters and numbers only (it goes into a connection URL).
MONGO_PASSWORD=change-me-to-a-long-random-password

# Optional: use MongoDB Atlas instead of the mongo container.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/connectly?retryWrites=true&w=majority

# --- Backend ---
# A long random string, e.g. from:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=3600
# "development" enables the /testData routes (seed/reset demo data). Use "production" when deployed.
APP_ENV=development
# Password of the demo accounts created by POST /testData/seed.
SEED_DEFAULT_USER_PASSWORD=

# --- Public addresses (as typed in the browser) ---
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001/api

# --- Ports on this computer ---
FRONTEND_PORT=3000
BACKEND_PORT=3001
